#!/usr/bin/env bash
set -euo pipefail

branch="$2"
url="$(git config --get remote.origin.url)"
repo="${url#git@github.com:}"
repo="${repo%.git}"
dest="$HOME/.worktrees/$repo/${branch//\//-}"

base="$(git ls-remote --symref origin HEAD | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2 }')"
git fetch -q origin
git worktree add -q -b "$branch" "$dest" "origin/$base"
