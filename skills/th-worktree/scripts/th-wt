#!/usr/bin/env bash
set -euo pipefail

shift
branch="$1"
shift
base=""
json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) base="$2"; shift 2 ;;
    --json) json=1; shift ;;
    *) shift ;;
  esac
done

url="$(git config --get remote.origin.url)"
repo="$(printf '%s' "$url" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##')"
dest="$HOME/.worktrees/$repo/${branch//\//-}"

[ -n "$base" ] || base="$(git ls-remote --symref origin HEAD | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2 }')"
git fetch -q origin
git worktree add -q -b "$branch" "$dest" "origin/$base"

if [ "$json" = 1 ]; then
  jq -n --arg path "$dest" --arg branch "$branch" --arg repo "$repo" '{path: $path, branch: $branch, repo: $repo}'
fi
