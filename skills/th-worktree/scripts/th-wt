#!/usr/bin/env bash
set -euo pipefail

for dep in git jq; do
  command -v "$dep" >/dev/null || { echo "th-wt: missing dependency: $dep" >&2; exit 3; }
done

shift
branch="$1"
shift
base=""
json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) base="$2"; shift 2 ;;
    --json) json=1; shift ;;
    *) shift ;;
  esac
done

url="$(git config --get remote.origin.url)"
repo="$(printf '%s' "$url" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##')"
dest="$HOME/.worktrees/$repo/${branch//\//-}"

if [ -e "$dest" ]; then
  echo "th-wt: destination already exists: $dest" >&2
  exit 4
fi

if git show-ref --verify --quiet "refs/heads/$branch" || [ -n "$(git ls-remote --heads origin "refs/heads/$branch")" ]; then
  echo "th-wt: branch already exists: $branch" >&2
  exit 4
fi

[ -n "$base" ] || base="$(git ls-remote --symref origin HEAD | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2 }')"
git fetch -q origin
git worktree add -q -b "$branch" "$dest" "origin/$base"

if [ "$json" = 1 ]; then
  jq -n --arg path "$dest" --arg branch "$branch" --arg repo "$repo" '{path: $path, branch: $branch, repo: $repo}'
fi
