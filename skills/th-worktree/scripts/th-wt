#!/usr/bin/env bash
set -euo pipefail

src="${BASH_SOURCE[0]}"
case "$src" in */*) ;; *) src="./$src" ;; esac
while [ -L "$src" ]; do
  dir="$(cd -P "${src%/*}" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR="$(cd -P "${src%/*}" && pwd)"
# shellcheck source=lib.sh source-path=SCRIPTDIR
. "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'USAGE'
Usage: th-wt new <branch> [--base <branch>] [--json]
       th-wt list [--remote] [--json]
       th-wt close <branch> [--remote] [--yes] [--force] [--json]

new    Create a git worktree for a new branch under ~/.worktrees.
list   Show this repo's worktrees under ~/.worktrees (local data only; --remote also fetches origin's default branch and queries GitHub PRs with gh).
close  Remove the worktree of <branch> under ~/.worktrees and its branch if merged. Dry-run unless --yes; --remote also queries the branch's GitHub PR (like list --remote): a merged PR with no later local commits counts as merged. --force also closes with uncommitted changes or unpushed commits.
USAGE
}

cmd="${1:-}"
case "$cmd" in
  new|list|close) ;;
  -h|--help) usage; exit 0 ;;
  *) bad_usage ;;
esac

for dep in git jq; do
  command -v "$dep" >/dev/null || die 3 "missing dependency: $dep"
done

shift
case "$cmd" in
  new)
    # shellcheck source=new.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/new.sh"
    new_worktree "$@" ;;
  list)
    # shellcheck source=list.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/list.sh"
    list_worktrees "$@" ;;
  close)
    # shellcheck source=close.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/close.sh"
    close_worktree "$@" ;;
esac
