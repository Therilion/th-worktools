#!/usr/bin/env bash
set -euo pipefail

src="${BASH_SOURCE[0]}"
case "$src" in */*) ;; *) src="./$src" ;; esac
while [ -L "$src" ]; do
  dir="$(cd -P "${src%/*}" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR="$(cd -P "${src%/*}" && pwd)"
# shellcheck source=lib.sh source-path=SCRIPTDIR
. "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'USAGE'
Usage: th-wt new <branch> [--base <branch>] [--json]
       th-wt checkout <branch> [--remote] [--json]
       th-wt list [--remote] [--json]
       th-wt pr <n> [--json]
       th-wt close <branch|path> [--remote] [--yes] [--force] [--json]
       th-wt link <branch> [--json]
       th-wt [new|checkout|list|pr|close|link] -h | --help

The worktrees root is TH_WORKTREES_ROOT (default ~/.worktrees). Settings come from the environment or from ${XDG_CONFIG_HOME:-$HOME/.config}/th-worktools/config (KEY=value lines; the environment wins). Keys: TH_WORKTREES_ROOT, TH_INSTALL_DEPS (0 or 1, default 1; 0 makes new and checkout skip the dependency install). An invalid setting exits with 4 before anything is created or deleted.

new       Create a git worktree for a new branch under the worktrees root, link the paths listed in the repo's .conf, then install its dependencies from the lockfile (pnpm-lock.yaml or package-lock.json; uses the network).
checkout  Create a git worktree for an existing branch under the worktrees root, link the paths listed in the repo's .conf, then install its dependencies from the lockfile (uses the network). Without --remote, origin is not queried; --remote also fetches the branch from origin when it is not local.
list      Show this repo's worktrees under the worktrees root (local data only; --remote also fetches origin's default branch and queries GitHub PRs with gh).
pr        Create a git worktree for GitHub PR <n> under the worktrees root, on a local branch review/pr-<n> (needs gh; always reads origin). Does not install dependencies: the PR code is untrusted.
close     Remove the worktree of <branch> under the worktrees root and its branch if merged. Dry-run unless --yes; --remote also queries the branch's GitHub PR (like list --remote): a merged PR with no later local commits counts as merged. --force also closes with uncommitted changes or unpushed commits. A path (starting with / or .) closes the worktree at that path, also one with a detached HEAD (mid rebase or bisect): its commits that are only in that HEAD block like unpushed ones, no branch is deleted, and --remote does not apply.
link      Re-apply the repo's .conf to the open worktree of <branch> under the worktrees root: create the links that are missing, with the same checks as new. Never deletes or replaces anything, does not install dependencies and does not use the network.
USAGE
}

cmd="${1:-}"
case "$cmd" in
  new|checkout|list|pr|close|link) ;;
  -h|--help) usage; exit 0 ;;
  "") bad_usage "missing subcommand" ;;
  *) bad_usage "unknown subcommand: $cmd" ;;
esac

for dep in git jq; do
  command -v "$dep" >/dev/null || die 3 "missing dependency: $dep"
done
# Agents have no terminal to answer git's credential prompt; fail instead of hanging.
export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=
# Same for ssh passphrases: BatchMode makes ssh fail instead of asking; keep the user's own ssh command.
# SSH_ASKPASS_REQUIRE=never also stops ssh from running a graphical askpass (OpenSSH >= 8.4; older ignore it).
export SSH_ASKPASS_REQUIRE=never
# shortcut: a caller GIT_SSH program (no GIT_SSH_COMMAND/core.sshCommand) gets no BatchMode, git offers no way to inject options there.
ssh_base="${GIT_SSH_COMMAND:-$(git config core.sshCommand || true)}"
if [ -n "$ssh_base" ] || [ -z "${GIT_SSH:-}" ]; then
  export GIT_SSH_COMMAND="${ssh_base:-ssh} -o BatchMode=yes"
fi

shift
case "$cmd" in
  new)
    # shellcheck source=new.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/new.sh"
    new_worktree "$@" ;;
  checkout)
    # shellcheck source=checkout.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/checkout.sh"
    checkout_worktree "$@" ;;
  list)
    # shellcheck source=list.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/list.sh"
    list_worktrees "$@" ;;
  pr)
    # shellcheck source=pr.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/pr.sh"
    pr_worktree "$@" ;;
  close)
    # shellcheck source=close.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/close.sh"
    close_worktree "$@" ;;
  link)
    # shellcheck source=link.sh source-path=SCRIPTDIR
    . "$SCRIPT_DIR/link.sh"
    link_worktree "$@" ;;
esac
